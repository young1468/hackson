PORT=3001

# Option A: OpenAI-compatible Chat Completions settings.
# LLM_BASE_URL should be a base API URL, for example:
# https://api.openai.com/v1
# Do not include /chat/completions here.
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5
LLM_API_KEY=replace_with_your_api_key

# Option B: Anthropic-compatible Messages API settings.
# ANTHROPIC_BASE_URL should be a base URL; server will append /v1/messages.
# Do not include /v1/messages here.
# If ANTHROPIC_AUTH_TOKEN or ANTHROPIC_BASE_URL is set, Anthropic mode is used first.
# ANTHROPIC_BASE_URL=https://example.com/anthropic
# ANTHROPIC_AUTH_TOKEN=replace_with_your_anthropic_token
# ANTHROPIC_MODEL=mimo-v2.5
# ANTHROPIC_DEFAULT_SONNET_MODEL=mimo-v2.5
# ANTHROPIC_DEFAULT_OPUS_MODEL=mimo-v2.5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=mimo-v2.5
